# Copy this file to .env.local and fill in your values

# Anthropic API Key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe Keys — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price ID — create a product at https://dashboard.stripe.com/products
# Set price to $9/month recurring
STRIPE_PRICE_ID=price_your_price_id_here

# App URL — change to your Vercel URL after deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT secret — generate a random 32+ char string
JWT_SECRET=replace_this_with_a_long_random_secret_string_32chars

# Free tier: how many roasts a non-subscriber gets
FREE_ROAST_LIMIT=1
